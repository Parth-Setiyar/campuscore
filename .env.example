# GEMINI_API_KEY: Required for Google Gemini AI academic remarks and student performance insights.
# Configure this in Settings > Secrets or your server environment. Never expose in frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key used to sign and verify session JWT tokens on the backend.
# If omitted in local development, an ephemeral secure key is generated in memory.
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# APP_URL: Public URL of the deployed CAMPUSCORE application (used for QR invitation links & CORS).
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000).
PORT="3000"

# SQLITE_DB_PATH: Path for the embedded relational SQLite database (defaults to ./data/campuscore.db).
SQLITE_DB_PATH="./data/campuscore.db"

# DATABASE_URL: Optional MySQL connection string when deploying with Docker Compose & Prisma.
DATABASE_URL="mysql://campuscore:campuscore_pass@localhost:3306/campuscore"
